<!-- [WinSW](https://github.com/winsw/winsw) -->
<service>
  <!-- ID of the service. It should be unique accross the Windows system. -->
  <id>PM2</id>
  <!-- Display name of the service -->
  <name>PM2</name>
  <!-- Service description -->
  <description>Node process manager</description>
  <!-- Path to the executable, which should be started -->
  <executable>node</executable>
  <!-- Defines account, under which the service should run. -->
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
    <password></password>
  </serviceaccount>
  <!-- Arguments, which should be passed to the executable -->
  <arguments>"%BASE%\node_modules\pm2\bin\pm2" resurrect --no-daemon</arguments>
  <!-- If specified, sets the default working directory of the executable. -->
  <workingdirectory></workingdirectory>
  <!-- Sets a custom logging directory for all logs being produced by the service wrapper. -->
  <logpath>%BASE%\.pm2\logs</logpath>
  <!-- Defines logging mode for logs produced by the executable. -->
  <log mode="append">
  </log>
  <!-- Sets or overrides environment variables. -->
  <env name="PM2_HOME" value="%BASE%\.pm2" />
  <env name="TEMP" value="%BASE%\.pm2\temp" />
  <env name="TMP" value="%TEMP%" />
</service>